<configuration name="event_socket.conf" description="Socket Client">
  <settings>
    <param name="nat-map" value="false"/>
    <!-- 0.0.0.0 so the port can be published out of the container; the
         loopback ACL is intentionally not applied. Restrict at the docker
         network level in real deployments. -->
    <param name="listen-ip" value="0.0.0.0"/>
    <param name="listen-port" value="8021"/>
    <param name="password" value="ClueCon"/>
    <param name="apply-inbound-acl" value="local.docker"/>
  </settings>
</configuration>
