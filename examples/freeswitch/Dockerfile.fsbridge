# Build context: repository root.
#   docker build -f examples/freeswitch/Dockerfile.fsbridge -t fsbridge .
FROM golang:1.26-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY bridge ./bridge
COPY pipeline ./pipeline
COPY providers ./providers
COPY cmd ./cmd
RUN CGO_ENABLED=0 go build -o /out/fsbridge ./cmd/fsbridge

FROM debian:bookworm-slim
COPY --from=build /out/fsbridge /usr/local/bin/fsbridge
EXPOSE 8080
ENTRYPOINT ["fsbridge", "-addr", ":8080"]
